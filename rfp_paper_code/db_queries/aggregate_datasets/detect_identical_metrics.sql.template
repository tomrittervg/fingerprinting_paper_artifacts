-- Detect metrics that are identical across all users.
--
-- Strategy: two-step detection to avoid expensive O(M^2 * N) pairwise join.
--   Step 1: Fingerprint each metric by its value distribution using
--           MetricValueCounts_tbl (~3M rows).  Two metrics can only be
--           identical if they have the exact same set of (value, count) pairs.
--   Step 2: Verify candidates with a targeted per-user join on
--           DoubleExploded_tbl (only candidate pairs — very few).
--
-- Run after process_13 (MetricValueCounts_tbl exists).
-- Output: IdenticalMetrics_tbl with (metric_kept, metric_dropped, n_users).
-- Convention: alphabetically first metric is kept.
--
-- Usage:
--   python3 bq.py --execute detect_identical_metrics.sql
--   python3 bq.py -q "SELECT * FROM {{DATASET}}.IdenticalMetrics_tbl"
--   python3 bq.py -q "SELECT metric_dropped FROM {{DATASET}}.IdenticalMetrics_tbl" \
--     --no-header > identical_metrics_to_drop.txt

CREATE OR REPLACE TABLE {{DATASET}}.IdenticalMetrics{{TBL_SUFFIX}}_tbl AS
WITH
-- Step 1: Fingerprint each metric by its value distribution (cheap).
-- Uses MetricValueCounts_tbl which has one row per (metric, value) with counts.
-- Two metrics with the same fingerprint have identical value distributions,
-- which is a necessary (but not sufficient) condition for per-user identity.
metric_fingerprints AS (
  SELECT metric,
    SHA256(STRING_AGG(
      CONCAT(value, '=', CAST(occurrences AS STRING))
      ORDER BY value
    )) AS fingerprint
  FROM {{DATASET}}.MetricValueCounts{{TBL_SUFFIX}}_tbl
  GROUP BY metric
),

-- Step 2: Find candidate groups — metrics with identical fingerprints.
-- Expected: a handful of groups (e.g. gl_renderer_raw = gl2_renderer_raw).
candidate_groups AS (
  SELECT fingerprint, ARRAY_AGG(metric ORDER BY metric) AS metrics
  FROM metric_fingerprints
  GROUP BY fingerprint
  HAVING COUNT(*) > 1
),

-- Expand groups into ordered pairs for verification.
candidate_pairs AS (
  SELECT m1, m2
  FROM candidate_groups,
    UNNEST(metrics) AS m1,
    UNNEST(metrics) AS m2
  WHERE m1 < m2
),

-- Step 3: Verify candidates with per-user join on DoubleExploded_tbl.
-- Only joins the candidate metric pairs (very few), not all M^2 pairs.
-- A pair is truly identical iff no user has different values for the two metrics.
verified AS (
  SELECT
    d1.metric AS metric1,
    d2.metric AS metric2,
    COUNT(*) AS n_users,
    COUNTIF(d1.value != d2.value) AS n_different
  FROM {{DATASET}}.DoubleExploded{{TBL_SUFFIX}}_tbl d1
  INNER JOIN {{DATASET}}.DoubleExploded{{TBL_SUFFIX}}_tbl d2
    ON d1.client_identifier = d2.client_identifier
  INNER JOIN candidate_pairs cp
    ON d1.metric = cp.m1
    AND d2.metric = cp.m2
  GROUP BY d1.metric, d2.metric
)

-- Output: keep alphabetically first, drop second.
-- Only include pairs with zero per-user differences.
SELECT
  metric1 AS metric_kept,
  metric2 AS metric_dropped,
  n_users,
  n_different
FROM verified
WHERE n_different = 0
ORDER BY metric_kept, metric_dropped;
