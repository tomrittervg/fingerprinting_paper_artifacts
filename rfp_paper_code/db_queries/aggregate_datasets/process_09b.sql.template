    if (/^HUAWEI\b/i.test(s))    return {vendor:'Huawei',    category:'mobile', family:'Huawei'};
    if (/^HONOR\b/i.test(s))     return {vendor:'Honor',     category:'mobile', family:'Honor'};
    if (/^Sony\b/i.test(s))      return {vendor:'Sony',      category:'mobile', family:'Sony_Xperia'};
    if (/^LGE?\b/i.test(s))      return {vendor:'LG',        category:'mobile', family:'LG'};

    // ASUS
    if (/^(?:ASUS|asus)\s/i.test(s) || /^(?:VivoBook|ZenBook|ROG\b|TUF\b|PRIME\b)/i.test(s)) {
      if (/VivoBook/i.test(s))               return {vendor:'ASUS', category:'laptop',  family:'ASUS_VivoBook'};
      if (/ZenBook/i.test(s))                return {vendor:'ASUS', category:'laptop',  family:'ASUS_ZenBook'};
      if (/\bROG\b/i.test(s))               return {vendor:'ASUS', category:'laptop',  family:'ASUS_ROG'};
      if (/\bTUF\b/i.test(s))               return {vendor:'ASUS', category:'laptop',  family:'ASUS_TUF'};
      if (/ExpertBook\b/i.test(s))           return {vendor:'ASUS', category:'laptop',  family:'ASUS_ExpertBook'};
      if (/\bPRIME\b/i.test(s))             return {vendor:'ASUS', category:'desktop', family:'ASUS_PRIME'};
      if (/ZenFone\b|ROG.Phone\b/i.test(s)) return {vendor:'ASUS', category:'mobile',  family:'ASUS_ZenFone'};
      return {vendor:'ASUS', category:'laptop', family:'ASUS'};
    }
    if (/^X[0-9]{3}[A-Z]{1,3}$/.test(s)) return {vendor:'ASUS', category:'laptop', family:'ASUS_VivoBook'};

    // Acer
    if (/^(?:Aspire|TravelMate|Veriton|Swift|Nitro|Extensa|Predator|Spin|ConceptD)\b/i.test(s)) {
      if (/^Aspire\b/i.test(s))     return {vendor:'Acer', category:'laptop',  family:'Acer_Aspire'};
      if (/^TravelMate\b/i.test(s)) return {vendor:'Acer', category:'laptop',  family:'Acer_TravelMate'};
      if (/^Veriton\b/i.test(s))    return {vendor:'Acer', category:'desktop', family:'Acer_Veriton'};
      if (/^Swift\b/i.test(s))      return {vendor:'Acer', category:'laptop',  family:'Acer_Swift'};
      if (/^Nitro\b/i.test(s))      return {vendor:'Acer', category:'laptop',  family:'Acer_Nitro'};
      if (/^Extensa\b/i.test(s))    return {vendor:'Acer', category:'laptop',  family:'Acer_Extensa'};
      if (/^Predator\b/i.test(s))   return {vendor:'Acer', category:'laptop',  family:'Acer_Predator'};
      if (/^Spin\b/i.test(s))       return {vendor:'Acer', category:'laptop',  family:'Acer_Spin'};
      return {vendor:'Acer', category:'unknown', family:'Acer'};
    }

    // Lenovo (named)
    if (/^(?:LENOVO|Lenovo)\b/i.test(s) || /^(?:ThinkPad|IdeaPad|IdeaCentre|ThinkCentre|ThinkStation|ThinkBook|ThinkSystem|Legion|Yoga)\b/i.test(s)) {
      var s2 = s.replace(/^(?:LENOVO|Lenovo)\s+/i, '').trim();
      s2 = s2.replace(/^(?:LENOVO|Lenovo)\s+/i, '').trim() || s;
      if (/^ThinkPad\b/i.test(s2))     return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_ThinkPad'};
      if (/^IdeaPad\b/i.test(s2))      return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_IdeaPad'};
      if (/^ThinkBook\b/i.test(s2))    return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_ThinkBook'};
      if (/^Legion\b/i.test(s2))       return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_Legion'};
      if (/^Yoga\b/i.test(s2))         return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_Yoga'};
      if (/^ThinkCentre\b/i.test(s2))  return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkCentre'};
      if (/^ThinkStation\b/i.test(s2)) return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkStation'};
      if (/^IdeaCentre\b/i.test(s2))   return {vendor:'Lenovo', category:'desktop', family:'Lenovo_IdeaCentre'};
      if (/^(?:TB|Tab)\b/i.test(s2) || /^TB\d/.test(s2)) return {vendor:'Lenovo', category:'tablet', family:'Lenovo_Tab'};
      if (/^ThinkSystem\b/i.test(s2))  return {vendor:'Lenovo', category:'server',  family:'Lenovo_ThinkSystem'};
      return {vendor:'Lenovo', category:'unknown', family:'Lenovo'};
    }
    // Lenovo numeric codes
    if (/^(?:2[01][A-Z0-9]{2}|10[A-Z][A-Z0-9]|30[A-Z][A-Z0-9]{2}|8[0-4][A-Z0-9]{2}|90[A-Z][A-Z0-9])/.test(s)) {
      if (/^2[01][A-Z0-9]{2}/.test(s)) return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_ThinkPad'};
      if (/^30[A-Z][A-Z0-9]/.test(s))  return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkStation'};
      if (/^10[A-Z][A-Z0-9]/.test(s))  return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkCentre'};
      if (/^8[0-4][A-Z0-9]{2}/.test(s))return {vendor:'Lenovo', category:'laptop',  family:'Lenovo_IdeaPad'};
      if (/^90[A-Z][A-Z0-9]/.test(s))  return {vendor:'Lenovo', category:'desktop', family:'Lenovo_IdeaCentre'};
      return {vendor:'Lenovo', category:'unknown', family:'Lenovo'};
    }
    if (/^C\d{4}\b/.test(s)) return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkStation'};

    // MSI
    if (/^MS-[A-Z0-9]{4}/.test(s)) return {vendor:'MSI', category:'desktop', family:'MSI_Desktop'};
    if (/^(?:GF|GL|GS\d|GP|GE|GV|Modern\b|Creator\b|Stealth\b|Prestige\b)/i.test(s)) return {vendor:'MSI', category:'laptop', family:'MSI_Laptop'};
    if (/^(?:Katana|Cyborg|Thin\b|Raider|Sword|Bravo|GamingPC|Crosshair|Vector|Pulse)\b/i.test(s)) return {vendor:'MSI', category:'laptop', family:'MSI_Laptop'};
    if (/^(?:MAG\b|MPG\b|MEG\b|MS-Challenger|MS-TZZ)/i.test(s)) return {vendor:'MSI', category:'desktop', family:'MSI_Desktop'};

    // Gigabyte / chipset boards
    if (/^GA-/i.test(s)) return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_Desktop'};
    if (/^(?:H\d{2,3}[A-Z]|B\d{3}[A-Z]?|Z\d{3}[A-Z]?|X\d{3}[A-Z]?|A[35]\d{2}[A-Z])/i.test(s)) {
      if (/\bAORUS\b/i.test(s))                           return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_AORUS'};
      if (/\bDS[23]H?\b/i.test(s))                        return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_Desktop'};
      if (/\bPro\s*(?:RS|4|4D)\b|\bHDV\b/i.test(s))      return {vendor:'ASRock',   category:'desktop', family:'ASRock_Desktop'};
      return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_Desktop'};
    }

    // Fujitsu
    if (/^(?:ESPRIMO|LIFEBOOK|CELSIUS|STYLISTIC|PRIMERGY|FMVU?[A-Z0-9])/i.test(s)) {
      if (/^ESPRIMO\b/i.test(s))  return {vendor:'Fujitsu', category:'desktop', family:'Fujitsu_ESPRIMO'};
      if (/^LIFEBOOK\b/i.test(s)) return {vendor:'Fujitsu', category:'laptop',  family:'Fujitsu_LIFEBOOK'};
      if (/^CELSIUS\b/i.test(s))  return {vendor:'Fujitsu', category:'desktop', family:'Fujitsu_CELSIUS'};
      if (/^PRIMERGY\b/i.test(s)) return {vendor:'Fujitsu', category:'server',  family:'Fujitsu_PRIMERGY'};
      return {vendor:'Fujitsu', category:'laptop', family:'Fujitsu_FMV'};
    }

    // Other known brands
    if (/^dynabook\b/i.test(s))    return {vendor:'Dynabook',   category:'laptop',  family:'Dynabook'};
    if (/^Satellite\b/i.test(s))   return {vendor:'Toshiba',    category:'laptop',  family:'Toshiba_Satellite'};
    if (/^(?:PORTEGE|TECRA|Qosmio)\b/i.test(s)) return {vendor:'Toshiba', category:'laptop', family:'Toshiba_Business'};
    if (/^Surface\b/i.test(s)) {
      if (/Surface\s+Laptop\b/i.test(s)) return {vendor:'Microsoft', category:'laptop',  family:'Microsoft_SurfaceLaptop'};
      if (/Surface\s+Book\b/i.test(s))   return {vendor:'Microsoft', category:'laptop',  family:'Microsoft_SurfaceBook'};
      if (/Surface\s+Studio\b/i.test(s)) return {vendor:'Microsoft', category:'desktop', family:'Microsoft_SurfaceStudio'};
      if (/Surface\s+Go\b/i.test(s))     return {vendor:'Microsoft', category:'tablet',  family:'Microsoft_SurfaceGo'};
      return {vendor:'Microsoft', category:'tablet', family:'Microsoft_SurfacePro'};
    }
    if (/^(?:HMD|Nokia)\b/i.test(s))   return {vendor:'Nokia',     category:'mobile', family:'Nokia'};
    if (/^SHARP\b/i.test(s))           return {vendor:'Sharp',     category:'mobile', family:'Sharp'};
    if (/^TCL\b/i.test(s))             return {vendor:'TCL',       category:'mobile', family:'TCL'};
    if (/^INFINIX\b/i.test(s))         return {vendor:'Infinix',   category:'mobile', family:'Infinix'};
    if (/^ITEL\b/i.test(s))            return {vendor:'Itel',      category:'mobile', family:'Itel'};
    if (/^TECNO\b/i.test(s))           return {vendor:'Tecno',     category:'mobile', family:'Tecno'};
    if (/^ZTE\b/i.test(s))             return {vendor:'ZTE',       category:'mobile', family:'ZTE'};
    if (/^nubia\b/i.test(s))           return {vendor:'ZTE',       category:'mobile', family:'ZTE_Nubia'};
    if (/^Nothing\b/i.test(s))         return {vendor:'Nothing',   category:'mobile', family:'Nothing'};
    if (/^Fairphone\b/i.test(s))       return {vendor:'Fairphone', category:'mobile', family:'Fairphone'};
    if (/^Blackview\b/i.test(s))       return {vendor:'Blackview', category:'mobile', family:'Blackview'};
    if (/^DOOGEE\b/i.test(s))          return {vendor:'DOOGEE',    category:'mobile', family:'DOOGEE'};
    if (/^Amazon\b/i.test(s))          return {vendor:'Amazon',    category:'tablet', family:'Amazon_Fire'};
    if (/^\d{3}X[A-Z]{2,3}$/.test(s))  return {vendor:'Samsung',  category:'laptop', family:'Samsung_GalaxyBook'};
    if (/^(?:Medion|Akoya)\b/i.test(s)) return {vendor:'Medion',   category:'laptop', family:'Medion'};
    if (/^Ulefone\b/i.test(s))  return {vendor:'Ulefone', category:'mobile', family:'Ulefone'};
    if (/^OUKITEL\b/i.test(s))  return {vendor:'OUKITEL', category:'mobile', family:'OUKITEL'};
    if (/^CUBOT\b/i.test(s))    return {vendor:'CUBOT',   category:'mobile', family:'CUBOT'};
    if (/^Teclast\b/i.test(s))  return {vendor:'Teclast', category:'tablet', family:'Teclast'};
    if (/^FCNT\b/i.test(s))     return {vendor:'FCNT',    category:'mobile', family:'FCNT_Arrows'};
    if (/^NEC\b/i.test(s))      return {vendor:'NEC',     category:'unknown', family:'NEC'};
    if (/^KYOCERA\b/i.test(s))  return {vendor:'Kyocera', category:'mobile', family:'Kyocera'};
    if (/^Positivo\b/i.test(s)) return {vendor:'Positivo', category:'laptop', family:'Positivo'};

    // Valve Steam Deck
    if (s === 'Jupiter' || s === 'Galileo') return {vendor:'Valve', category:'handheld', family:'Valve_SteamDeck'};
    // Intel NUC
    if (/^NUC/i.test(s)) return {vendor:'Intel', category:'desktop', family:'Intel_NUC'};
    // ASUS sub-brands
    if (/^ASUSPRO\b/i.test(s)) return {vendor:'ASUS', category:'desktop', family:'ASUS_Pro'};
    if (/^ASUS_MB_/i.test(s)) return {vendor:'ASUS', category:'desktop', family:'ASUS_Desktop'};
    if (/^(?:ProArt|Strix)\b/i.test(s)) return {vendor:'ASUS', category:'desktop', family:'ASUS_Desktop'};
    if (/^Zephyrus\b/i.test(s)) return {vendor:'ASUS', category:'laptop', family:'ASUS_ROG'};
    // Mini PCs
    if (/^(?:SER|EQ|EliteMini|GTR|SEi|EQi)\d/i.test(s)) return {vendor:'Beelink', category:'desktop', family:'Beelink_MiniPC'};
    if (/^(?:NucBox|MiniPC|MINIPC)\b/i.test(s)) return {vendor:'MiniPC', category:'desktop', family:'MiniPC'};
    // Acer sub-brands
    if (/^EasyNote\b/i.test(s)) return {vendor:'Acer', category:'laptop', family:'Acer_PackardBell'};
    // Samsung laptop codes
    if (/^300E[0-9]/.test(s)) return {vendor:'Samsung', category:'laptop', family:'Samsung_Laptop'};
    if (/^950[A-Z]/.test(s)) return {vendor:'Samsung', category:'laptop', family:'Samsung_GalaxyBook'};
    // Xiaomi sub-brands
    if (/^RedmiBook\b/i.test(s)) return {vendor:'Xiaomi', category:'laptop', family:'Xiaomi_RedmiBook'};
    if (/^Mi\s/.test(s)) return {vendor:'Xiaomi', category:'mobile', family:'Xiaomi_Mi'};
    if (/^Galaxy\b/i.test(s)) return {vendor:'Samsung', category:'mobile', family:'Samsung_Galaxy'};
    // Additional mobile brands
    if (/^(?:BLU|Blu)\b/.test(s)) return {vendor:'BLU', category:'mobile', family:'BLU'};
    if (/^(?:Cat|CAT)\b/.test(s)) return {vendor:'Cat', category:'mobile', family:'Cat'};
    if (/^WIKO\b/i.test(s)) return {vendor:'WIKO', category:'mobile', family:'WIKO'};
    if (/^LAVA\b/i.test(s)) return {vendor:'LAVA', category:'mobile', family:'LAVA'};
    if (/^UMIDIGI\b/i.test(s)) return {vendor:'UMIDIGI', category:'mobile', family:'UMIDIGI'};
    if (/^Unihertz\b/i.test(s)) return {vendor:'Unihertz', category:'mobile', family:'Unihertz'};
    if (/^OSCAL\b/i.test(s)) return {vendor:'Blackview', category:'mobile', family:'Blackview'};
    if (/^HOTWAV\b/i.test(s)) return {vendor:'HOTWAV', category:'mobile', family:'HOTWAV'};
    if (/^Doro\b/i.test(s)) return {vendor:'Doro', category:'mobile', family:'Doro'};
    if (/^HTC\b/i.test(s)) return {vendor:'HTC', category:'mobile', family:'HTC'};
    if (/^(?:AYN|AYANEO)\b/i.test(s)) return {vendor:'AYANEO', category:'handheld', family:'AYANEO'};
    if (/^Gigaset\b/i.test(s)) return {vendor:'Gigaset', category:'mobile', family:'Gigaset'};
    if (/^Crosscall\b/i.test(s)) return {vendor:'Crosscall', category:'mobile', family:'Crosscall'};
    if (/^Alldocube\b/i.test(s)) return {vendor:'Alldocube', category:'tablet', family:'Alldocube'};
    if (/^SHIFT\b/i.test(s)) return {vendor:'SHIFT', category:'mobile', family:'SHIFT'};
    if (/^Zebra\b/i.test(s)) return {vendor:'Zebra', category:'mobile', family:'Zebra'};
    if (/^Honeywell\b/i.test(s)) return {vendor:'Honeywell', category:'mobile', family:'Honeywell'};
    if (/^TINNO\b/i.test(s)) return {vendor:'TINNO', category:'mobile', family:'TINNO'};
    if (/^Wingtech\b/i.test(s)) return {vendor:'Wingtech', category:'mobile', family:'Wingtech'};
    if (/^Hisilicon\b/i.test(s)) return {vendor:'Huawei', category:'mobile', family:'Huawei'};
    if (/^onn\b/i.test(s)) return {vendor:'Walmart', category:'tablet', family:'Walmart_Onn'};
    // Desktop PCs / workstations
    if (/^TERRA_PC\b/i.test(s)) return {vendor:'TERRA', category:'desktop', family:'TERRA'};
    if (/^(?:exone|bluechip|BUSINESSline|CORSAIR|NZXT)\b/i.test(s)) return {vendor:'Desktop', category:'desktop', family:'Desktop_Custom'};
    if (/^(?:AORUS|GIGABYTE)\b/i.test(s)) return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_Desktop'};
    // Bare chipset names → desktop motherboard
    if (/^(?:H\d{2,3}|B\d{2,3}|Z\d{2,3}|X\d{2,3}|A\d{3}M?)$/.test(s)) return {vendor:'Desktop', category:'desktop', family:'Desktop_Motherboard'};
    if (/^(?:AB?\d{3}|Z\d{2,3}X?|X\d{2,3})-/.test(s)) return {vendor:'Gigabyte', category:'desktop', family:'Gigabyte_Desktop'};
    if (/^(?:IPMH|IPM)\d/i.test(s)) return {vendor:'Desktop', category:'desktop', family:'Desktop_Motherboard'};
    // Lenovo full product codes
    var lm = s.match(/^LENOVO_MT_\w+_(?:BU_\w+_)?FM_(\w+)/);
    if (lm) {
      var brand = lm[1];
      if (brand === 'ThinkPad' || brand === 'ThinkBook') return {vendor:'Lenovo', category:'laptop', family:'Lenovo_'+brand};
      if (brand === 'IdeaPad') return {vendor:'Lenovo', category:'laptop', family:'Lenovo_IdeaPad'};
      if (brand === 'Legion' || brand === 'LOQ') return {vendor:'Lenovo', category:'laptop', family:'Lenovo_Legion'};
      if (brand === 'Yoga') return {vendor:'Lenovo', category:'laptop', family:'Lenovo_Yoga'};
      if (brand === 'ThinkCentre') return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkCentre'};
      if (brand === 'ThinkStation') return {vendor:'Lenovo', category:'desktop', family:'Lenovo_ThinkStation'};
      if (brand === 'IdeaCentre') return {vendor:'Lenovo', category:'desktop', family:'Lenovo_IdeaCentre'};
      return {vendor:'Lenovo', category:'unknown', family:'Lenovo'};
    }
    if (/^LENOVO_MT_/.test(s)) return {vendor:'Lenovo', category:'unknown', family:'Lenovo'};

    // Fallback — Other (real but unrecognized) or Unknown (garbage/generic)
    var first = s.split(/\s/)[0] || s;
    var low = first.toLowerCase();
    var mmLabel;
    if (['desktop','laptop','computer','pc','work','home','mypc','custom','standard','business','default','empty','super','pro','one','all','us','by','not','none','unknown','invalid','mini','aio'].indexOf(low) >= 0) {
      mmLabel = 'Unknown';
    } else if (first.length <= 3 || /^\d+$/.test(first) || /^[0-9][0-9A-Fa-f]*$/.test(first) || first === first.toLowerCase()) {
      mmLabel = 'Unknown';
    } else {
      mmLabel = 'Other';
    }
    return {vendor:mmLabel, category:'unknown', family:mmLabel};
  }
  return classify(raw);
""";

-- ── WebGL renderer classifier ──────────────────────────────────────────────

CREATE TEMP FUNCTION classify_webgl_renderer(raw STRING)
RETURNS STRUCT<vendor STRING, family STRING, model STRING, api STRING>
LANGUAGE js AS r"""
  function strip(s) { return s.replace(/\s*\((?:R|TM)\)/g, '').trim(); }

  function classifyIntel(name) {
    if (/Iris\s+Xe|Xe\s+Graphics/i.test(name)) return ['Intel_IrisXe','Intel_IrisXe'];
    if (/Iris\s+Pro/i.test(name)) {
      var m = name.match(/(\d{4})/);
      return ['Intel_IrisPro', m ? 'Intel_IrisPro_'+m[1] : 'Intel_IrisPro'];
    }
    if (/\bIris\b/i.test(name)) {
      var m = name.match(/(\d{3,4})/);
      return ['Intel_Iris', m ? 'Intel_Iris_'+m[1] : 'Intel_Iris'];
    }
    if (/\bUHD\b/i.test(name)) {
      var m = name.match(/UHD\s+(?:Graphics\s+)?(\d{3,4})/i);
      return ['Intel_UHD', m ? 'Intel_UHD_'+m[1] : 'Intel_UHD'];
    }
    if (/\bHD\b/i.test(name)) {
      var m = name.match(/HD\s+(?:Graphics\s+)?(\d{3,4})/i);
      return ['Intel_HD', m ? 'Intel_HD_'+m[1] : 'Intel_HD'];
    }
    return ['Intel_Graphics','Intel_Graphics'];
  }

  function classifyNvidia(name) {
    if (/\bRTX\b/i.test(name)) {
      var m = name.match(/RTX\s+([\d]+\s*\w*)/i);
      if (m) { var tag = m[1].trim().replace(/\s+/g,'_'); return ['NVIDIA_RTX','NVIDIA_RTX_'+tag]; }
      return ['NVIDIA_RTX','NVIDIA_RTX'];
    }
    if (/\bGTX\b/i.test(name)) {
      var m = name.match(/GTX\s+([\d]+\w*)/i);
      return ['NVIDIA_GTX', m ? 'NVIDIA_GTX_'+m[1] : 'NVIDIA_GTX'];
    }
    if (/\bQuadro\b/i.test(name)) return ['NVIDIA_Quadro','NVIDIA_Quadro'];
    if (/\bTesla\b/i.test(name))  return ['NVIDIA_Tesla','NVIDIA_Tesla'];
    var m = name.match(/(\d{3,4}\w*)/);
    return ['NVIDIA', m ? 'NVIDIA_'+m[1] : 'NVIDIA'];
  }

  function classifyAmd(name) {
    if (/\bATI\b/i.test(name)) {
      var m = name.match(/HD\s+(\d+)/i);
      return ['AMD_ATI', m ? 'AMD_ATI_HD'+m[1] : 'AMD_ATI'];
    }
    if (/Radeon\s+RX\b/i.test(name)) {
      var m = name.match(/RX\s+([\d]+\s*\w*)/i);
      if (m) {
        var tag = m[1].trim();
        var d = tag.match(/^(\d)/);
        var fam = d ? 'AMD_RX_'+d[1]+'xxx' : 'AMD_RX';
        return [fam, 'AMD_RX_'+tag.replace(/\s+/g,'_')];
      }
      return ['AMD_RX','AMD_RX'];
    }
    if (/Radeon\s+Pro\b/i.test(name)) {
      var m = name.match(/Pro\s+(\w+)/i);
      return ['AMD_RadeonPro', m ? 'AMD_RadeonPro_'+m[1] : 'AMD_RadeonPro'];
    }
    if (/\bVega\b/i.test(name)) {
      var m = name.match(/Vega\s+(\d+)/i);
      return ['AMD_Vega', m ? 'AMD_Vega'+m[1] : 'AMD_Vega'];
    }
    if (/Radeon\s+R[579]\b/i.test(name)) {
      var m = name.match(/(R[579])/i);
      var fam = m ? 'AMD_'+m[1].toUpperCase() : 'AMD_R';
      return [fam, fam];
    }
    if (/Custom\s+GPU/i.test(name)) {
      var m = name.match(/Custom\s+GPU\s+(\w+)/i);
      return ['AMD_Custom', m ? 'AMD_Custom_'+m[1] : 'AMD_Custom'];
    }
    if (/Radeon\s+Graphics/i.test(name)) return ['AMD_RadeonGraphics','AMD_RadeonGraphics'];
    var m = name.match(/Radeon\s+(\w+)/i);
    if (m) return ['AMD_Radeon','AMD_Radeon_'+m[1]];
    return ['AMD','AMD'];
  }

  function classifyMali(name, api) {
    var m = name.match(/^Mali-([GT])(\d+)/i);
    if (m) {
      var gen = m[1].toUpperCase();
      var model = name.trim().replace(/\s+/g,'_');
      return ['Mali','Mali_'+gen,model,api];
    }
    return ['Mali','Mali',name,api];
  }

  function parseAngleGpu(outer_vendor, gpu_api_str) {
    var gpu_name = gpu_api_str.replace(/\s+(?:Direct3D\d+|OpenGL\s+[\d.]+|Vulkan\s+[\d.]+)\b.*$/i, '').trim();
    gpu_name = strip(gpu_name);
    var ov = outer_vendor.toLowerCase();
    if (ov.includes('intel'))       { var r=classifyIntel(gpu_name);  return ['Intel',r[0],r[1]]; }
    if (ov.includes('nvidia'))      { var r=classifyNvidia(gpu_name); return ['NVIDIA',r[0],r[1]]; }
    if (ov.includes('amd'))         { var r=classifyAmd(gpu_name);    return ['AMD',r[0],r[1]]; }
    if (ov.includes('microsoft'))   return ['Microsoft','Microsoft_BasicRender','Microsoft_BasicRender'];
    if (ov.includes('samsung'))     return ['Samsung','Samsung_Xclipse',gpu_name];
    if (ov.includes('arm')) {
      var cleaned = gpu_name.replace(/\s*\(0x[0-9a-fA-F]+\)/g,'').trim();
      var vk = cleaned.match(/^Vulkan\s+[\d.]+\s*\((.+)\)\s*$/i);
      if (vk) {
        var inner = vk[1].trim();
        if (/^Mali-/i.test(inner)) { var r=classifyMali(inner,'ANGLE_Vulkan'); return [r[0],r[1],r[2]]; }
      }
      if (/^Mali-/i.test(gpu_name)) { var r=classifyMali(gpu_name,'ANGLE_Vulkan'); return [r[0],r[1],r[2]]; }
      return ['Mali','Mali',gpu_name];
    }
    if (ov.includes('imagination') || ov.includes('powervr')) return ['PowerVR','PowerVR',gpu_name];
    if (/Parallels\b/i.test(gpu_name)) return ['Microsoft','Microsoft_Parallels','Microsoft_Parallels'];
    if (/qualcomm|adreno/i.test(gpu_name)) {
      var am = gpu_name.match(/Adreno\s+(X?\d[\w\-]*)/i);
      if (am) {
        var chip = am[1];
        if (chip.toUpperCase().startsWith('X')) return ['Adreno','Adreno_X','Adreno_'+chip];
        return ['Adreno','Adreno_'+chip[0]+'00s','Adreno_'+chip];
      }
      return ['Adreno','Adreno',gpu_name];
    }
    return [outer_vendor,outer_vendor,gpu_name];
  }

  function normalizeRenderer(s) {
    if (!s || s === 'None') return {vendor:'None',family:'None',model:'None',api:'unknown'};
    s = s.trim();

    // Samsung Xclipse
    var xm = s.match(/^angle\s*\(+samsung\s+xclipse\s+(\d+)/i);
    if (xm) return {vendor:'Samsung',family:'Samsung_Xclipse',model:'Samsung_Xclipse_'+xm[1],api:'ANGLE_Vulkan'};

    // Virtio-GPU Venus
    if (s.includes('Virtio-GPU Venus')) {
      var vm = s.match(/Virtio-GPU Venus \(((?:[^()]|\([^()]*\))+?)\)/);
      var outer_m = s.match(/^ANGLE\s*\(\s*([^,()]+)/i);
      var outer_vendor = outer_m ? outer_m[1].trim() : 'Unknown';
      if (vm) {
        var inner = vm[1].replace(/\s*\([^)]+\)\s*$/, '').replace(/\(R\)|\(TM\)/gi,'').trim();
        if (/^Mali-/i.test(inner)) { var r=classifyMali(inner,'ANGLE_Vulkan'); return {vendor:r[0],family:r[1],model:r[2],api:r[3]}; }
        if (/\bIntel\b/i.test(inner)) { var r=classifyIntel(inner); return {vendor:'Intel',family:r[0],model:r[1],api:'ANGLE_Vulkan'}; }
        if (/\bAMD\b/i.test(inner)) { var r=classifyAmd(inner); return {vendor:'AMD',family:r[0],model:r[1],api:'ANGLE_Vulkan'}; }
        return {vendor:outer_vendor,family:outer_vendor,model:inner,api:'ANGLE_Vulkan'};
      }
      return {vendor:'Unknown',family:'Unknown',model:'Virtio-GPU',api:'ANGLE_Vulkan'};
    }

    // virgl
    if (/^virgl\b/i.test(s)) {
      var vm = s.match(/^virgl\s*\(\s*(.+?)\s*\)\s*$/i);
      if (vm) {
        var inner = vm[1];
        var inner_clean = inner.replace(/\s*\([^)]*\)\s*$/, '').trim();
        if (/\bIntel\b/i.test(inner_clean)) {
          var gpu_clean = strip(inner_clean.replace(/^Mesa\s+(?:DRI\s+)?/i,'').replace(/\s*\([^)]+\)\s*$/,'').trim());
          var r = classifyIntel(gpu_clean);
          return {vendor:'Intel',family:r[0],model:r[1],api:'Mesa'};
        }
        var am = inner_clean.match(/^Apple\s+(M\d+)((?:\s+\w+)?)/);
        if (am) {
          var gen=am[1], variant=am[2].trim();
          var mod = variant ? 'Apple_'+gen+'_'+variant : 'Apple_'+gen;
          return {vendor:'Apple',family:'Apple_'+gen,model:mod,api:'macOS'};
        }
      }
      return {vendor:'Unknown',family:'virgl',model:'virgl',api:'Mesa'};
    }

    // Standard ANGLE
    if (/^ANGLE\s*\(/i.test(s)) {
      var inner_m = s.match(/^ANGLE\s*\(\s*([^,()]+?)\s*,\s*(.*)\s*\)\s*$/i);
      if (inner_m) {
        var outer_vendor = inner_m[1].trim();
        var rest = inner_m[2].trim();
        var lc = rest.lastIndexOf(',');
        if (lc >= 0) {
          var gpu_api_part = rest.substring(0, lc).trim();
          var driver_part  = rest.substring(lc+1).trim().toUpperCase();
          var api;
          if (driver_part.startsWith('D3D11') || gpu_api_part.toUpperCase().includes('DIRECT3D11')) api = 'ANGLE_D3D11';
          else if (driver_part.startsWith('D3D9') || gpu_api_part.toUpperCase().includes('DIRECT3D9')) api = 'ANGLE_D3D9';
          else if (gpu_api_part.toUpperCase().includes('VULKAN') || driver_part.startsWith('VK')) api = 'ANGLE_Vulkan';
          else if (driver_part.startsWith('GL_') || gpu_api_part.toUpperCase().includes('OPENGL')) api = 'ANGLE_GL';
          else if (driver_part.startsWith('MTL') || driver_part.includes('METAL')) api = 'ANGLE_Metal';
          else api = 'ANGLE';
          var r = parseAngleGpu(outer_vendor, gpu_api_part);
          return {vendor:r[0],family:r[1],model:r[2],api:api};
        }
      }
      var om = s.match(/^ANGLE\s*\(\s*([^,()]+)/i);
      var outer = om ? om[1].trim() : 'ANGLE';
      return {vendor:'Unknown',family:'ANGLE',model:'ANGLE_'+outer,api:'ANGLE'};
    }

    // Software renderers
    var sl = s.toLowerCase();
    if (sl.startsWith('llvmpipe'))       return {vendor:'software',family:'software_llvmpipe',model:'software_llvmpipe',api:'software'};
    if (sl.includes('swiftshader'))      return {vendor:'software',family:'software_SwiftShader',model:'software_SwiftShader',api:'software'};
    if (sl.startsWith('softpipe'))       return {vendor:'software',family:'software_softpipe',model:'software_softpipe',api:'software'};
    if (s === 'Apple Software Renderer') return {vendor:'software',family:'software_Apple',model:'software_Apple',api:'software'};

    // Gallium
    var gm = s.match(/^Gallium.*?\bon\s+(\S+)/i);
    if (gm) {
      var target = gm[1], tl = target.toLowerCase().replace(/\($/, '');
      if (tl.includes('llvmpipe') || tl.includes('softpipe')) return {vendor:'software',family:'software_llvmpipe',model:'software_llvmpipe',api:'software'};
      if (/^nv[0-9a-f]{2}/i.test(tl)) return {vendor:'NVIDIA',family:'NVIDIA',model:'NVIDIA_Nouveau_'+target.toUpperCase(),api:'Mesa'};
      return {vendor:'Unknown',family:'Gallium_'+target,model:'Gallium_'+target,api:'Mesa'};
    }

    // Mesa Intel/AMD
    if (/^Mesa\s+(?:DRI\s+|Mobile\s+|i965\s+)?(?:Intel|AMD|Radeon)/i.test(s)) {
      var is_intel = /\bIntel\b/i.test(s.substring(0,50));
      var gpu_part = s.replace(/^Mesa\s+(?:DRI\s+|Mobile\s+|i965\s+)?/i,'').replace(/\s*\([^)]+\)\s*$/,'').trim();
      var gpu_clean = strip(gpu_part);
      if (is_intel) { var r=classifyIntel(gpu_clean); return {vendor:'Intel',family:r[0],model:r[1],api:'Mesa'}; }
      var r = classifyAmd(gpu_clean);
      return {vendor:'AMD',family:r[0],model:r[1],api:'Mesa'};
    }

    // AMD Mesa with radeonsi/amdgpu parenthetical
    if (/^(?:AMD|Radeon)\b/i.test(s) && /\([^)]*(?:radeonsi|amdgpu|,\s*LLVM\b)/i.test(s)) {
      var gpu_name = s.substring(0, s.indexOf('(')).trim();
      var r = classifyAmd(gpu_name);
      return {vendor:'AMD',family:r[0],model:r[1],api:'Mesa'};
    }

    // AMD codename (e.g. RENOIR (renoir, ...))
    var cm = s.match(/^([A-Z][A-Z0-9]+)\s*\(([a-z][a-z0-9_]+|,)/);
    if (cm) {
      var codename = cm[1];
      var title = codename.charAt(0)+codename.slice(1).toLowerCase();
      return {vendor:'AMD',family:'AMD_'+title,model:'AMD_'+title,api:'Mesa'};
    }

    // Maleoon
    if (/^Maleoon\b/i.test(s)) {
      var mm = s.match(/^Maleoon\s+(\w+)/i);
      var chip = mm ? mm[1] : '';
      return {vendor:'Maleoon',family:'Maleoon',model:chip?'Maleoon_'+chip:'Maleoon',api:'mobile'};
    }

    // Mali
    if (/^Mali-/i.test(s)) { var r=classifyMali(s,'mobile'); return {vendor:r[0],family:r[1],model:r[2],api:r[3]}; }

    // Imagination Technologies
    if (/^Imagination\s+Technologies/i.test(s)) return {vendor:'PowerVR',family:'PowerVR',model:'PowerVR',api:'mobile'};

    // Adreno
    if (/^Adreno\s*(?:\(TM\))?\s*$/i.test(s)) return {vendor:'Adreno',family:'Adreno',model:'Adreno',api:'mobile'};
    var am = s.match(/^Adreno\s+(?:\(TM\)\s+)?([\w\-]+)/i);
    if (am) {
      var chip = am[1].trim();
      if (chip.toUpperCase().startsWith('X')) return {vendor:'Adreno',family:'Adreno_X',model:'Adreno_'+chip,api:'mobile'};
      var series = chip[0].match(/\d/) ? chip[0]+'00s' : chip;
      return {vendor:'Adreno',family:'Adreno_'+series,model:'Adreno_'+chip,api:'mobile'};
    }

    // PowerVR
    if (s.startsWith('PowerVR')) {
      var pm = s.match(/^PowerVR\s+(\S+)(?:\s+(\S+))?/);
      if (pm) {
        var w1=pm[1], w2=pm[2]||'';
        var chip = w2||w1, series = w2?w1:'';
        if (w1.includes('BXM')||w2.includes('BXM')) {
          var cm2=s.match(/(BXM[\w\-]+)/); chip=cm2?cm2[1]:chip;
          return {vendor:'PowerVR',family:'PowerVR_BXM',model:'PowerVR_'+chip,api:'mobile'};
        }
        if (/[DA]XT/.test(w1)||/[DA]XT/.test(w2)) {
          var cm2=s.match(/([DA]XT[\w\-]+)/); chip=cm2?cm2[1]:chip;
          return {vendor:'PowerVR',family:'PowerVR_DXT',model:'PowerVR_'+chip,api:'mobile'};
        }
        var fam = series?'PowerVR_'+series:'PowerVR';
        return {vendor:'PowerVR',family:fam,model:'PowerVR_'+chip,api:'mobile'};
      }
      return {vendor:'PowerVR',family:'PowerVR',model:s,api:'mobile'};
    }

    // Vulkan version prefix wrapping GPU name
    var vk_m = s.match(/^Vulkan\s+[\d.]+\s*\((.+)\)\s*$/i);
    if (vk_m) {
      var inner = vk_m[1].trim().replace(/\s*\(0x[0-9a-fA-F]+\)\s*$/, '').trim();
      if (/\bPowerVR\b/i.test(inner)) return normalizeRenderer(inner);
      if (/^Mali-/i.test(inner)) { var r=classifyMali(inner,'mobile'); return {vendor:r[0],family:r[1],model:r[2],api:r[3]}; }
      return {vendor:'Unknown',family:'Unknown',model:inner,api:'unknown'};
    }

    // Parallels
    if (/Parallels/i.test(s)) return {vendor:'Microsoft',family:'Microsoft_Parallels',model:'Microsoft_Parallels',api:'ANGLE_D3D11'};

    // i915 ancient Intel Mesa
    if (/^i915\b/i.test(s)) return {vendor:'Intel',family:'Intel_Graphics',model:'Intel_i915',api:'Mesa'};

    // V3D Raspberry Pi
    if (/^V3D\b/.test(s)) return {vendor:'Broadcom',family:'Broadcom_V3D',model:'Broadcom_V3D',api:'Mesa'};

    // Freedreno (FDxxx)
    var fd_m = s.match(/^FD(\d+)\s*$/i);
    if (fd_m) return {vendor:'Adreno',family:'Adreno_Freedreno',model:'Adreno_FD'+fd_m[1],api:'Mesa'};

    // Apple Silicon
    var apple_m = s.match(/^Apple\s+(M\d+)((?:\s+\w+)?)/);
    if (apple_m) {
      var gen=apple_m[1], variant=apple_m[2].trim();
      var mod = variant ? 'Apple_'+gen+'_'+variant : 'Apple_'+gen;
      return {vendor:'Apple',family:'Apple_'+gen,model:mod,api:'macOS'};
    }

    // macOS Intel
    if (/^Intel\b/i.test(s)) {
      var clean = strip(s).replace(/\s+OpenGL Engine.*$/i,'').trim();
      var r = classifyIntel(clean);
      return {vendor:'Intel',family:r[0],model:r[1],api:'macOS'};
    }

    // macOS AMD/ATI
    if (/^(?:AMD|ATI)\b/i.test(s)) {
      var clean = strip(s).replace(/\s+OpenGL Engine.*$/i,'').trim();
      var r = classifyAmd(clean);
      return {vendor:'AMD',family:r[0],model:r[1],api:'macOS'};
    }

    // NVIDIA bare Nouveau chip codes
    if (/^NV[0-9A-Fa-f]{2,4}\s*$/.test(s)) return {vendor:'NVIDIA',family:'NVIDIA',model:'NVIDIA_Nouveau_'+s.trim().toUpperCase(),api:'Mesa'};

    // GeForce/Quadro/NVS or /PCIe/SSE2
    if (/^(?:GeForce|Quadro|NVS)\b/i.test(s) || s.includes('/PCIe/SSE2')) {
      var clean = s.replace(/\s*\/PCIe.*$/i,'').trim();
      var r = classifyNvidia(clean);
      return {vendor:'NVIDIA',family:r[0],model:r[1],api:'Mesa'};
    }

    // macOS NVIDIA
    if (/^NVIDIA\b/i.test(s)) {
      var clean = strip(s).replace(/\s+OpenGL Engine.*$/i,'').trim();
      var r = classifyNvidia(clean);
      return {vendor:'NVIDIA',family:r[0],model:r[1],api:'macOS'};
    }

    // Version-prefixed driver strings
    var ver_m = s.match(/^(\d+\.\d+)(?:\.\d+)?\s+(NVIDIA|ATI|INTEL)-/);
    if (ver_m) {
      var brand = ver_m[2].toUpperCase();
      var map = {NVIDIA:['NVIDIA','NVIDIA','NVIDIA','macOS'],ATI:['AMD','AMD_ATI','AMD_ATI','macOS'],INTEL:['Intel','Intel','Intel','macOS']};
      var r = map[brand] || ['Unknown','Unknown','Unknown','macOS'];
      return {vendor:r[0],family:r[1],model:r[2],api:r[3]};
    }

    // "4.6.0 NVIDIA 390.xx" Linux style
    if (/^\d+\.\d+\.\d+\s+NVIDIA\s+[\d.]+/.test(s)) return {vendor:'NVIDIA',family:'NVIDIA',model:'NVIDIA',api:'Linux'};

    // Metal version string
    if (/^\d+\.\d+\s+Metal\s*-/.test(s)) return {vendor:'Unknown',family:'Metal',model:'Metal',api:'macOS'};

    // Mesa version string
    if (/^\d+\.\d+.*\bMesa\b/.test(s)) return {vendor:'Unknown',family:'Mesa',model:'Mesa',api:'Mesa'};

    // OpenGL ES with ANGLE
    if (/^OpenGL\s+ES.*ANGLE/i.test(s)) return {vendor:'Unknown',family:'ANGLE',model:'ANGLE_GLES',api:'ANGLE'};

    // Fallback — keep model as cleaned raw, use clean labels for vendor/family
    var modelClean = s.trim().replace(/\s+/g, '_');
    var glLabel;
    if (!s || s.length <= 3 || /^\d/.test(s) || s === s.toLowerCase() || s.indexOf(';') >= 0) {
      glLabel = 'Unknown';
    } else {
      glLabel = 'Other';
    }
    return {vendor:glLabel, family:glLabel, model:modelClean, api:'unknown'};
  }

  return normalizeRenderer(raw);
""";

-- ── Insert classified rows into DoubleExploded_tbl ────────────────────────

INSERT INTO {{DATASET}}.DoubleExploded{{TBL_SUFFIX}}_tbl
SELECT
  e.client_identifier,
  col.metric,
  col.value
FROM {{DATASET}}.Exploded{{TBL_SUFFIX}}_tbl e
CROSS JOIN UNNEST([
  -- CPU model classification
  STRUCT('hw_cpu_model_manufacturer' AS metric, classify_cpu_model(e.cpu_model).manufacturer AS value),
  STRUCT('hw_cpu_model_family'        AS metric, classify_cpu_model(e.cpu_model).family       AS value),
  STRUCT('hw_cpu_model_microarch'     AS metric, classify_cpu_model(e.cpu_model).microarch    AS value),
  STRUCT('hw_cpu_model_model'         AS metric, classify_cpu_model(e.cpu_model).model        AS value),
  -- Machine model classification
  STRUCT('hw_machine_model_vendor'   AS metric, classify_machine_model(e.machine_model_name).vendor   AS value),
  STRUCT('hw_machine_model_category' AS metric, classify_machine_model(e.machine_model_name).category AS value),
  STRUCT('hw_machine_model_family'   AS metric, classify_machine_model(e.machine_model_name).family   AS value),
  -- WebGL1 renderer classification
  STRUCT('webgl_renderer_vendor' AS metric, classify_webgl_renderer(e.gl_renderer_raw).vendor AS value),
  STRUCT('webgl_renderer_family' AS metric, classify_webgl_renderer(e.gl_renderer_raw).family AS value),
  STRUCT('webgl_renderer_model'  AS metric, classify_webgl_renderer(e.gl_renderer_raw).model  AS value),
  STRUCT('webgl_renderer_api'    AS metric, classify_webgl_renderer(e.gl_renderer_raw).api    AS value),
  -- WebGL2 renderer classification
  STRUCT('webgl2_renderer_vendor' AS metric, classify_webgl_renderer(e.gl2_renderer_raw).vendor AS value),
  STRUCT('webgl2_renderer_family' AS metric, classify_webgl_renderer(e.gl2_renderer_raw).family AS value),
  STRUCT('webgl2_renderer_model'  AS metric, classify_webgl_renderer(e.gl2_renderer_raw).model  AS value),
  STRUCT('webgl2_renderer_api'    AS metric, classify_webgl_renderer(e.gl2_renderer_raw).api    AS value)
]) AS col
;
